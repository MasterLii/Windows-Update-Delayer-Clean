<Window x:Class="Windows_Update_Delayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Windows_Update_Delayer"
        mc:Ignorable="d"
        Title="Windows 更新暂停工具 v2.1" Height="500" Width="630" ResizeMode="CanMinimize" Icon="images/logo.png" Background="#F5F7FA">

    <Grid>
        <!-- 纯色背景由 Window.Background 控制，此处保持背景透明以显露底色 -->

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/> <!-- 标题 -->
            <RowDefinition Height="Auto"/> <!-- 暂停区 -->
            <RowDefinition Height="Auto"/> <!-- 版本区 -->
            <RowDefinition Height="*"/> <!-- 操作区 -->
            <RowDefinition Height="30"/> <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#FF2980B9" CornerRadius="0,0,10,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                <Image Height="60" Width="60" Source="images/logo.png" Margin="0,0,20,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24" Text="Windows 更新控制器" Foreground="White" FontWeight="Bold"/>
                    <TextBlock FontSize="12" Text="SYSTEM UPDATE MANAGEMENT TOOL" Foreground="#E1F5FE" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 第一部分：暂停更新 -->
        <GroupBox Grid.Row="1" Header=" 核心功能：快速暂停系统更新 " Margin="25,20,25,10" FontSize="14" Foreground="#2C3E50" BorderBrush="#D1D9E6" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                <Button Content="暂停至 2027" Width="135" Height="55" FontSize="18" FontWeight="SemiBold" Background="#FF3498DB" Foreground="White" Click="Button_Click_1" Margin="12,0" Cursor="Hand" BorderThickness="0"/>
                <Button Content="暂停至 2035" Width="135" Height="55" FontSize="18" FontWeight="SemiBold" Background="#FF3498DB" Foreground="White" Click="Button_Click_2" Margin="12,0" Cursor="Hand" BorderThickness="0"/>
                <Button Content="暂停至 2054" Width="135" Height="55" FontSize="18" FontWeight="SemiBold" Background="#FF3498DB" Foreground="White" Click="Button_Click_3" Margin="12,0" Cursor="Hand" BorderThickness="0"/>
            </StackPanel>
        </GroupBox>

        <!-- 第二部分：高级控制 -->
        <GroupBox Grid.Row="2" Header=" 高级选项：版本策略锁定 " Margin="25,10,25,10" FontSize="14" Foreground="#2C3E50" BorderBrush="#D1D9E6" BorderThickness="1">
            <Grid Margin="10,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="禁止系统大版本升级" Width="180" Height="80" FontSize="16" Background="#E67E22" Foreground="White" Click="Button_BlockFeatureUpdate" Cursor="Hand" BorderThickness="0" Margin="10,0,25,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="锁定 Windows 11 最高更新版本：" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#34495E"/>
                    <UniformGrid Columns="3">
                        <Button Content="22H2" Height="45" FontSize="16" Background="#5DADE2" Foreground="White" Click="Button_StayOn22H2" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                        <Button Content="23H2" Height="45" FontSize="16" Background="#5DADE2" Foreground="White" Click="Button_StayOn23H2" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                        <Button Content="24H2" Height="45" FontSize="16" Background="#5DADE2" Foreground="White" Click="Button_StayOn24H2" Cursor="Hand" BorderThickness="0"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 底部操作区 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
            <Button Content="恢复 Windows 默认更新" Width="200" Height="45" FontSize="15" Background="#34495E" Foreground="White" Click="Button_Click_4" Margin="15,0" Cursor="Hand" BorderThickness="0"/>
            <Button Content="立即检查更新页面" Width="200" Height="45" FontSize="15" Background="#27AE60" Foreground="White" Click="Button_Click_5" Margin="15,0" Cursor="Hand" BorderThickness="0"/>
        </StackPanel>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="#ECF0F1" BorderBrush="#D1D9E6" BorderThickness="0,1,0,0">
            <TextBlock Text="💡 提示：修改注册表策略可能需要重新检查更新或重启系统后生效" 
                       Foreground="#7F8C8D" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
        </Border>
    </Grid>
</Window>
